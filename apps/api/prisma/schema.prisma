// Mô hình dữ liệu BrewLite – khớp Class-01 (docs/diagrams/class-domain.puml).
// Mỗi thay đổi tạo migration bằng `npx prisma migrate dev --name <mô-tả>` (ADR-003).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Đồ uống trên menu. `price` là giá size S (BR-01). Số ly còn bán được không lưu riêng mà tính từ
// tồn kho nguyên liệu theo công thức `recipe` (BR-09, ADR-011).
model Product {
  id          Int                 @id @default(autoincrement())
  name        String
  description String
  price       Int
  imageUrl    String
  createdAt   DateTime            @default(now())
  recipe      ProductIngredient[]
}

model Topping {
  id     Int                 @id @default(autoincrement())
  name   String              @unique
  price  Int
  recipe ToppingIngredient[]
}

// Nguyên liệu trong kho. `stock` tính theo `unit`; `version` dùng cho optimistic locking (ADR-006).
// `scalesWithSize = false` với thứ dùng đúng 1 cái mỗi ly bất kể size (ly nhựa).
model Ingredient {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  unit           String
  stock          Int
  version        Int                 @default(0)
  scalesWithSize Boolean             @default(true)
  products       ProductIngredient[]
  toppings       ToppingIngredient[]
}

// Công thức 1 ly size S; size M, L dùng nhiều hơn theo tỉ lệ ở BR-09
model ProductIngredient {
  productId    Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Int

  @@id([productId, ingredientId])
}

// Lượng nguyên liệu cho 1 phần topping, không đổi theo size
model ToppingIngredient {
  toppingId    Int
  topping      Topping    @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Int

  @@id([toppingId, ingredientId])
}

enum Role {
  CUSTOMER
  STAFF
}

// Email lưu chữ thường để kiểm tra trùng không phân biệt hoa thường (FR-06)
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          Role     @default(CUSTOMER)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
}

// Mã giảm giá theo phần trăm (BR-04)
model Promotion {
  code       String    @id
  percentOff Int
  minTotal   Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
}
