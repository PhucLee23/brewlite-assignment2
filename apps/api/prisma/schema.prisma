// Mô hình dữ liệu BrewLite – khớp Class-01 (docs/diagrams/class-domain.puml).
// Mỗi thay đổi tạo migration bằng `npx prisma migrate dev --name <mô-tả>` (ADR-003).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Đồ uống trên menu. `price` là giá size S (BR-01). Số ly còn bán được không lưu riêng mà tính từ
// tồn kho nguyên liệu theo công thức `recipe` (BR-09, ADR-011).
model Product {
  id          Int                 @id @default(autoincrement())
  name        String
  description String
  price       Int
  imageUrl    String
  createdAt   DateTime            @default(now())
  recipe      ProductIngredient[]
  orderItems  OrderItem[]
}

model Topping {
  id     Int                 @id @default(autoincrement())
  name   String              @unique
  price  Int
  recipe ToppingIngredient[]
}

// Nguyên liệu trong kho. `stock` tính theo `unit`; `version` dùng cho optimistic locking (ADR-006).
// `scalesWithSize = false` với thứ dùng đúng 1 cái mỗi ly bất kể size (ly nhựa).
model Ingredient {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  unit           String
  stock          Int
  version        Int                 @default(0)
  scalesWithSize Boolean             @default(true)
  products       ProductIngredient[]
  toppings       ToppingIngredient[]
  orderUsages    OrderIngredient[]
}

// Công thức 1 ly size S; size M, L dùng nhiều hơn theo tỉ lệ ở BR-09
model ProductIngredient {
  productId    Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Int

  @@id([productId, ingredientId])
}

// Lượng nguyên liệu cho 1 phần topping, không đổi theo size
model ToppingIngredient {
  toppingId    Int
  topping      Topping    @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Int

  @@id([toppingId, ingredientId])
}

enum Role {
  CUSTOMER
  STAFF
}

// Email lưu chữ thường để kiểm tra trùng không phân biệt hoa thường (FR-06)
model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  fullName            String
  role                Role                 @default(CUSTOMER)
  // Luôn bằng tổng points của các LoyaltyTransaction của người dùng (FR-13)
  loyaltyPoints       Int                  @default(0)
  createdAt           DateTime             @default(now())
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

// Mã giảm giá theo phần trăm (BR-04)
model Promotion {
  code       String    @id
  percentOff Int
  minTotal   Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  orders     Order[]
}

enum Size {
  S
  M
  L
}

// Vòng đời đơn theo BR-06; chỉ đổi qua transitionOrder()
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

model Order {
  id             Int                  @id @default(autoincrement())
  userId         Int
  user           User                 @relation(fields: [userId], references: [id])
  status         OrderStatus          @default(PENDING)
  subtotal       Int
  discount       Int                  @default(0)
  total          Int
  promotionCode  String?
  promotion      Promotion?           @relation(fields: [promotionCode], references: [code])
  // Khóa chống tạo đơn trùng, lưu dạng userId:key (ADR-006)
  idempotencyKey String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          OrderItem[]
  // Nguyên liệu đã trừ khi đặt đơn; hủy đơn trả lại đúng chừng này (FR-16, FR-20)
  ingredients    OrderIngredient[]
  payments       Payment[]
  loyalty        LoyaltyTransaction[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

// Ảnh chụp tên món, topping và giá lúc đặt, không đổi khi menu đổi giá
model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  size        Size
  toppings    String[]
  qty         Int
  unitPrice   Int
  lineTotal   Int

  @@index([orderId])
}

// Lượng nguyên liệu đã trừ cho một đơn (cộng dồn mọi dòng của đơn)
model OrderIngredient {
  orderId      Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Int

  @@id([orderId, ingredientId])
}

// Cổng thanh toán bên thứ ba, môi trường sandbox (ADR-010)
enum PaymentProvider {
  MOMO
  VNPAY
}

enum PaymentStatus {
  PROCESSING
  SUCCESS
  FAILED
}

// Phiên thanh toán ở cổng MoMo hoặc VNPay. Tạo ở PROCESSING; chỉ kết quả có chữ ký của cổng (link quay về, IPN,
// API tra cứu) mới đổi sang SUCCESS / FAILED (BR-07). Quá 15 phút chưa có kết quả thì đánh FAILED (FR-11).
model Payment {
  id             Int             @id @default(autoincrement())
  orderId        Int
  order          Order           @relation(fields: [orderId], references: [id])
  // Khóa giữ chỗ chống trừ tiền hai lần, duy nhất toàn hệ thống (ADR-006)
  idempotencyKey String          @unique
  amount         Int
  provider       PaymentProvider
  status         PaymentStatus   @default(PROCESSING)
  // Mã đơn gửi sang cổng: không trùng kể cả khi nhiều máy dùng chung một tài khoản sandbox
  gatewayOrderId String          @unique
  // Link trang thanh toán của cổng
  payUrl         String?
  // Bằng chứng do cổng xác nhận: mã giao dịch, ngân hàng, hình thức trả, dữ liệu gốc có chữ ký (FR-26)
  gatewayRef     String?
  bankCode       String?
  payType        String?
  gatewayResult  Json?
  createdAt      DateTime        @default(now())
  confirmedAt    DateTime?

  @@index([orderId, status])
  @@index([createdAt])
}

enum LoyaltyType {
  EARN
  REVOKE
}

// Giao dịch điểm thưởng; mỗi đơn tối đa một EARN và một REVOKE (BR-05, ADR-006)
model LoyaltyTransaction {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id])
  type      LoyaltyType
  points    Int
  createdAt DateTime    @default(now())

  @@unique([orderId, type])
  @@index([userId, createdAt])
}
