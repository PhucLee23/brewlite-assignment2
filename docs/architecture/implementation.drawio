<mxfile host="app.diagrams.net"><diagram id="implementation" name="implementation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Sơ đồ triển khai theo vai trò (implementation diagram) – môi trường production&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1580" height="30" as="geometry"/></mxCell><mxCell id="dev" value="«device»&lt;br&gt;&lt;b&gt;Thiết bị người dùng&lt;/b&gt;&lt;br&gt;trình duyệt / PWA" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=center;spacingTop=6;fillColor=#FFF8EE;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="240" height="470" as="geometry"/></mxCell><mxCell id="rKH" value="«vai trò»&lt;br&gt;&lt;b&gt;Khách hàng&lt;/b&gt;&lt;br&gt;CUSTOMER" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="200" height="90" as="geometry"/></mxCell><mxCell id="c2" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#5A3A22;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="230" width="22" height="44" as="geometry"/></mxCell><mxCell id="rNV" value="«vai trò»&lt;br&gt;&lt;b&gt;Nhân viên quầy&lt;/b&gt;&lt;br&gt;STAFF" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="90" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#5A3A22;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="22" height="44" as="geometry"/></mxCell><mxCell id="vercel" value="«PaaS» &lt;b&gt;Vercel&lt;/b&gt; (CDN, HTTPS)&lt;br&gt;apps/web – một bản build Next.js" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=center;spacingTop=6;fillColor=#FFF8EE;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="290" height="470" as="geometry"/></mxCell><mxCell id="kKH" value="«artifact»&lt;br&gt;&lt;b&gt;Khu khách hàng&lt;/b&gt;&lt;br&gt;/ (Menu), /products/[id], /cart,&lt;br&gt;/checkout, /payments/[id],&lt;br&gt;/orders, /orders/[id], biên lai,&lt;br&gt;/login, /register" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="350" y="190" width="250" height="140" as="geometry"/></mxCell><mxCell id="kQL" value="«artifact»&lt;br&gt;&lt;b&gt;Khu quản lý&lt;/b&gt; (chỉ vai trò STAFF)&lt;br&gt;/staff – Quầy&lt;br&gt;/admin/ingredients – Kho&lt;br&gt;/admin/revenue – Doanh thu" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="350" y="400" width="250" height="120" as="geometry"/></mxCell><mxCell id="guard" value="«lớp bảo vệ»&lt;br&gt;&lt;b&gt;Cổng vào API&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTTPS 443&lt;br&gt;CORS: chỉ origin của web&lt;br&gt;JwtAuthGuard: kiểm JWT&lt;br&gt;RolesGuard: API quản lý cần&lt;br&gt;STAFF (khách gọi → 403)&lt;br&gt;ValidationPipe: kiểm DTO" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FDECEA;strokeColor=#B85450;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="690" y="230" width="210" height="250" as="geometry"/></mxCell><mxCell id="render" value="«Docker container» &lt;b&gt;Render Web Service&lt;/b&gt;&lt;br&gt;API NestJS – image từ GHCR, GET /health" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=center;spacingTop=6;fillColor=#FFF8EE;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="970" y="120" width="300" height="560" as="geometry"/></mxCell><mxCell id="aKH" value="«artifact»&lt;br&gt;&lt;b&gt;Phần khách hàng&lt;/b&gt;&lt;br&gt;products, auth, promotions,&lt;br&gt;orders: đặt, xem, hủy đơn&lt;br&gt;payments: mở phiên, kết quả, biên lai&lt;br&gt;loyalty: điểm thưởng" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="990" y="190" width="260" height="140" as="geometry"/></mxCell><mxCell id="aQL" value="«artifact»&lt;br&gt;&lt;b&gt;Phần quản lý&lt;/b&gt; (@Roles(&#x27;STAFF&#x27;))&lt;br&gt;orders: Quầy, đổi trạng thái&lt;br&gt;ingredients: kho, nhập kho&lt;br&gt;payments: GET /payments (doanh thu)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="990" y="360" width="260" height="120" as="geometry"/></mxCell><mxCell id="aGW" value="«artifact»&lt;br&gt;&lt;b&gt;payments/gateways&lt;/b&gt;&lt;br&gt;MoMo (HMAC-SHA256)&lt;br&gt;VNPay (HMAC-SHA512)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="990" y="510" width="260" height="90" as="geometry"/></mxCell><mxCell id="neon" value="«DBaaS» &lt;b&gt;Neon&lt;/b&gt; – PostgreSQL 16&lt;br&gt;lưu trữ bền vững; chỉ API giữ chuỗi kết nối" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;verticalAlign=top;align=center;spacingTop=6;fillColor=#FFF8EE;strokeColor=#5A3A22;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1340" y="120" width="300" height="560" as="geometry"/></mxCell><mxCell id="g1" value="«nhóm bảng»&lt;br&gt;&lt;b&gt;Menu và kho&lt;/b&gt;&lt;br&gt;Product, Topping, Ingredient,&lt;br&gt;ProductIngredient, ToppingIngredient" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1360" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="g2" value="«nhóm bảng»&lt;br&gt;&lt;b&gt;Khách hàng và đơn&lt;/b&gt;&lt;br&gt;User, Order, OrderItem,&lt;br&gt;OrderIngredient, Promotion,&lt;br&gt;LoyaltyTransaction" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1360" y="320" width="260" height="115" as="geometry"/></mxCell><mxCell id="g3" value="«nhóm bảng»&lt;br&gt;&lt;b&gt;Thanh toán&lt;/b&gt;&lt;br&gt;Payment (cổng, mã giao dịch,&lt;br&gt;bằng chứng xác nhận)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1360" y="465" width="260" height="95" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Cổng MoMo, VNPay&lt;/b&gt;&lt;br&gt;bên thứ ba, sandbox" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="980" y="740" width="280" height="110" as="geometry"/></mxCell><mxCell id="c4" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="rKH" target="kKH"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="rNV" target="kQL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="REST JSON + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="kKH" target="guard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="REST JSON + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="kQL" target="guard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="guard" target="aKH"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="guard" target="aQL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="TCP 5432, TLS (Prisma)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="render" target="neon"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="tạo giao dịch, tra cứu (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" edge="1" parent="1" source="aGW" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="IPN có chữ ký" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="gate" target="aGW"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="795"/><mxPoint x="1305" y="555"/></Array></mxGeometry></mxCell><mxCell id="c13" value="khách trả tiền trên trang của cổng (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;dashed=1;exitX=0.5;exitY=1;entryX=0.07;entryY=0.5;" edge="1" parent="1" source="dev" target="gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="795"/></Array></mxGeometry></mxCell><mxCell id="c14" value="Một bản build web phục vụ cả hai khu; khu quản lý chỉ hiện với tài khoản STAFF.&lt;br&gt;API kiểm vai trò ở mọi request (RolesGuard), nên dù khách tự gõ đường dẫn khu quản lý cũng nhận 403.&lt;br&gt;CSDL không mở ra Internet cho người dùng: chỉ API và job migrate của CD giữ chuỗi kết nối (secret)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#FFFDE7;strokeColor=#B8A040;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="900" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
