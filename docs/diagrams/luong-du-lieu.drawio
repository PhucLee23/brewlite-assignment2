<mxfile host="app.diagrams.net"><diagram id="luong-du-lieu" name="luong-du-lieu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Luồng dữ liệu BrewLite: đặt món, thanh toán, xử lý đơn và kho&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;CSDL PostgreSQL&lt;/b&gt;&lt;br&gt;menu, công thức,&lt;br&gt;tồn nguyên liệu,&lt;br&gt;đơn hàng, thanh toán" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="200" height="170" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Tạo đơn&lt;/b&gt; POST /orders&lt;br&gt;server tính giá,&lt;br&gt;trừ nguyên liệu trong transaction" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="250" height="100" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Mở phiên thanh toán&lt;/b&gt;&lt;br&gt;POST /payments&lt;br&gt;(MoMo hoặc VNPay)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="230" height="100" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Trang thanh toán&lt;/b&gt;&lt;br&gt;của cổng MoMo / VNPay&lt;br&gt;(bên thứ ba)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;dashed=1;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="220" height="100" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Ghi kết quả một lần&lt;/b&gt;&lt;br&gt;kiểm chữ ký, hỏi lại cổng;&lt;br&gt;PAID, cộng điểm thưởng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="270" width="220" height="110" as="geometry"/></mxCell><mxCell id="bl" value="&lt;b&gt;Biên lai&lt;/b&gt;&lt;br&gt;mã giao dịch của cổng" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.12;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="280" width="170" height="90" as="geometry"/></mxCell><mxCell id="dt" value="&lt;b&gt;Doanh thu&lt;/b&gt; /admin/revenue&lt;br&gt;tiền đã vào, cần hoàn tiền" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.12;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="460" width="220" height="90" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Quầy pha chế&lt;/b&gt; /staff&lt;br&gt;PREPARING → READY&lt;br&gt;→ COMPLETED" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="460" width="230" height="100" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b&gt;Hủy đơn hoặc quá 15 phút&lt;/b&gt;&lt;br&gt;trả lại đúng lượng&lt;br&gt;nguyên liệu đã trừ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontColor=#222222;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="640" width="250" height="100" as="geometry"/></mxCell><mxCell id