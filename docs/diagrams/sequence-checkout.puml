@startuml sequence-checkout
' Sequence-01: UC-06 Đặt và thanh toán đơn hàng (Task 2.2)
' Liên kết: FR-07, FR-08, FR-10, FR-11, FR-12, FR-13, FR-14; NFR-04, NFR-06; BR-09; ADR-006, ADR-010, ADR-011
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantBackgroundColor #FFF8EE
skinparam ParticipantBorderColor #5A3A22
skinparam ActorBorderColor #5A3A22
skinparam SequenceGroupBackgroundColor #F3D9B1
autonumber "<b>0."

actor "Customer" as C
participant "Next.js UI" as UI
participant "NestJS API" as API
database "Database\n(PostgreSQL)" as DB
participant "Cổng MoMo / VNPay\n(bên thứ ba, sandbox)" as PG

C -> UI : Chọn cổng MoMo hoặc VNPay,\nbấm "Thanh toán … qua <cổng>"
activate UI
UI -> UI : orderKey = khóa của giỏ hàng hiện tại\n(giữ nguyên nếu giỏ không đổi)

== Tạo đơn hàng ==
UI -> API : POST /orders\nAuthorization: Bearer <JWT>\nIdempotency-Key: orderKey\n{ items[], promotionCode? }
activate API
API -> API : JwtAuthGuard kiểm tra chữ ký và hạn JWT
alt JWT thiếu / sai / hết hạn
  API --> UI : 401 Unauthorized
  UI --> C : Đăng xuất, chuyển tới trang Đăng nhập
else JWT hợp lệ
  API -> API : ValidationPipe kiểm tra DTO\n(qty 1–20, size S/M/L, ≤ 5 topping)
  opt Dữ liệu không hợp lệ
    API --> UI : 400 + thông báo tiếng Việt
  end
  API -> DB : SELECT Order WHERE idempotencyKey = "userId:orderKey"
  DB --> API : (không có)
  API -> DB : SELECT Product, Topping kèm công thức nguyên liệu; Promotion
  DB --> API : giá, công thức, mã giảm giá
  API -> API : Tính giá phía server (BR-01, BR-04);\ncộng dồn nguyên liệu cần theo size (BR-09)
  group Transaction (READ COMMITTED)
    loop từng nguyên liệu theo ingredientId tăng dần
      API -> DB : SELECT stock, version FROM Ingredient WHERE id = ?
      DB --> API : stock, version
      API -> DB : UPDATE Ingredient SET stock = stock - cần, version = version + 1\nWHERE id = ? AND version = ?
      DB --> API : số dòng cập nhật (1 = thành công, 0 = xung đột → đọc lại, thử lại)
    end
    API -> DB : INSERT Order (PENDING) + OrderItem[] + OrderIngredient[]
    DB --> API : order
  end
  alt Không đủ nguyên liệu
    API --> UI : 409 "‹món› size ‹L› chỉ còn N ly" (transaction rollback)
    UI --> C : Báo lỗi, giữ nguyên giỏ hàng
  else Tạo đơn thành công
    API --> UI : 201 Order { id, status: PENDING, total }
  end
end
deactivate API

== Mở phiên thanh toán ở cổng ==
UI -> UI : payKey = khóa mới cho lần thanh toán này
UI -> API : POST /payments\nAuthorization: Bearer <JWT>\nIdempotency-Key: payKey\n{ orderId, provider, returnOrigin }
activate API
API -> API : JwtAuthGuard + ValidationPipe
API -> DB : SELECT Payment WHERE idempotencyKey = payKey
DB --> API : (không có)
group Transaction: giữ chỗ khóa thanh toán
  API -> DB : SELECT id FROM "Order" WHERE id = ? FOR UPDATE
  API -> DB : Kiểm tra đơn thuộc khách, ở PENDING / PAYMENT_FAILED,\nchưa có phiên PROCESSING còn hạn
  API -> DB : INSERT Payment (PROCESSING, provider, amount = order.total,\nidempotencyKey UNIQUE, gatewayOrderId ngẫu nhiên)
  DB --> API : payment
end
alt provider = VNPAY
  API -> API : Ký link thanh toán HMAC-SHA512(vnp_HashSecret)\n(số tiền, mã giao dịch, link quay về, hạn 15 phút)
else provider = MOMO
  API -> PG : POST /v2/gateway/api/create\n(chữ ký HMAC-SHA256, hạn 15 phút)
  PG --> API : payUrl
end
alt Cổng không mở được giao dịch
  API -> DB : UPDATE Payment SET status = FAILED
  API --> UI : 502 + lý do (khách bấm lại hoặc chọn cổng khác)
else Mở được
  API -> DB : UPDATE Payment SET payUrl
  API --> UI : 201 { id, paymentUrl, expiresAt, replayed: false }\n(đơn vẫn PENDING)
end
deactivate API
UI --> C : Chuyển trình duyệt sang paymentUrl
deactivate UI

== Khách trả tiền trên trang của cổng ==
C -> PG : Nhập thẻ (hoặc quét mã bằng app),\nxác nhận trả tiền hoặc bấm Hủy
activate PG
PG -> PG : Kiểm tra chữ ký link, xử lý giao dịch
PG --> C : Chuyển về /payments/:id?<kết quả có chữ ký>
opt API có địa chỉ công khai (production)
  PG -> API : IPN (MoMo: POST /payments/momo/ipn,\nVNPay: GET /payments/vnpay/ipn) kèm chữ ký
end
deactivate PG

C -> UI : Mở trang chờ /payments/:id
activate UI
UI -> API : POST /payments/:id/return { params } (JWT)
activate API
API -> API : Kiểm tra chữ ký của cổng (so sánh thời gian hằng)\nvà mã giao dịch khớp phiên
alt Sai chữ ký / của giao dịch khác
  API --> UI : 400 (không đổi trạng thái)
else Hợp lệ
  API -> PG : Tra cứu giao dịch (VNPay querydr, MoMo /api/query)
  PG --> API : trạng thái, số tiền, mã giao dịch (có chữ ký)
  API -> API : Kiểm tra số tiền = Payment.amount
  group Transaction: ghi kết quả (link quay về, IPN, tra cứu dùng chung)
    API -> DB : SELECT id FROM "Order" WHERE id = ? FOR UPDATE
    API -> DB : SELECT Payment
    alt Payment không còn PROCESSING (kết quả đến lần hai)
      API -> API : Bỏ qua, không cộng điểm lần hai
    else Thành công
      API -> DB : UPDATE Payment SET status = SUCCESS, gatewayRef, bankCode,\npayType, gatewayResult, confirmedAt
      API -> DB : UPDATE Order SET status = PAID WHERE id = ? AND status = PENDING
      API -> DB : INSERT LoyaltyTransaction (EARN, +total/1000 điểm)\nUPDATE User SET loyaltyPoints += điểm
    else Thất bại (khách bấm Hủy, cổng từ chối)
      API -> DB : UPDATE Payment SET status = FAILED, confirmedAt
      API -> DB : UPDATE Order SET status = PAYMENT_FAILED WHERE id = ? AND status = PENDING
    end
  end
  API --> UI : 200 { status, order: { status } }
end
deactivate API

opt Khách trả bằng app trên điện thoại khác, không quay về trang chờ
  loop mỗi 1,5 giây khi phiên còn mở
    UI -> API : GET /payments/:id (JWT)
    API -> PG : Tra cứu giao dịch (tối đa mỗi 4 giây)
    PG --> API : kết quả có chữ ký
    API -> DB : Ghi kết quả như trên (chỉ một lần)
    API --> UI : { status, order: { status } }
  end
end

alt Đơn PAID
  UI -> UI : Xóa giỏ hàng, cập nhật điểm trên header
  UI --> C : Màn hình xác nhận: mã đơn, PAID,\nđiểm vừa cộng, nhắc tới quầy, nút xem biên lai
else Đơn PAYMENT_FAILED hoặc phiên hết hạn
  UI --> C : Báo lỗi kèm mã đơn, giữ nguyên giỏ hàng,\ncho chọn cổng thanh toán lại (khóa thanh toán mới)
end

== Client gửi lại yêu cầu mở phiên (mạng chậm, hết thời gian chờ) ==
UI -> API : POST /payments\nIdempotency-Key: payKey (cùng khóa cũ)
activate API
API -> DB : SELECT Payment WHERE idempotencyKey = payKey
DB --> API : payment đã có với khóa này
alt Khóa đã dùng cho đơn khác / của người khác
  API --> UI : 409 Conflict
else Đã có phiên với khóa này
  API --> UI : 201 { cùng id, paymentUrl, replayed: true }\nkhông mở giao dịch mới ở cổng, không cộng điểm lần hai
end
deactivate API
deactivate UI
@enduml
