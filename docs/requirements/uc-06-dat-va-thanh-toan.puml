@startuml uc-06-dat-va-thanh-toan
' Use-case diagram cho phạm vi UC-06 Đặt và thanh toán đơn hàng (Task 1.3)
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #FFF8EE
  BorderColor #5A3A22
}
skinparam actorBorderColor #5A3A22

actor "Khách hàng" as Customer
actor "Cổng thanh toán\nMoMo, VNPay\n(bên thứ ba, sandbox)" as Gateway <<hệ thống>>

rectangle "BrewLite – phạm vi UC-06" {
  usecase "Áp dụng mã giảm giá\n(UC-07)" as Promo
  usecase "UC-06 Đặt và thanh toán\nđơn hàng" as UC06 #F3D9B1
  usecase "Đăng nhập\n(UC-05)" as Login
  usecase "Tạo đơn hàng\nvà trừ nguyên liệu" as CreateOrder
  usecase "Thanh toán trên trang\ncủa MoMo hoặc VNPay" as Pay
  usecase "Xác nhận kết quả có chữ ký\n(link quay về, IPN, tra cứu)" as Confirm
  usecase "Thanh toán lại\nđơn bị lỗi" as Retry
  usecase "Cộng điểm thưởng" as Earn
}

Customer --> UC06
Promo ..> UC06 : <<extend>>\n[khách nhập mã]
UC06 ..> Login : <<include>>
UC06 ..> CreateOrder : <<include>>
UC06 ..> Pay : <<include>>
Pay ..> Confirm : <<include>>
Earn ..> Confirm : <<extend>>\n[thanh toán thành công]
Retry ..> Pay : <<extend>>\n[thanh toán thất bại]
Pay --> Gateway
Confirm <-- Gateway
@enduml
