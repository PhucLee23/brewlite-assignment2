@startuml use-case-overview
' Sơ đồ use-case tổng quát của BrewLite (Task 1.2)
' Bên trái: tác nhân phía khách; bên phải: nhân viên và hệ thống ngoài
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #FFF8EE
  BorderColor #5A3A22
}
skinparam actorBorderColor #5A3A22

actor "Khách vãng lai" as Guest
actor "Khách hàng\n(đã đăng nhập)" as Customer
actor "Nhân viên quầy" as Staff
actor "Cổng thanh toán\nMoMo, VNPay\n(bên thứ ba, sandbox)" as Gateway <<hệ thống>>
actor "Bộ hẹn giờ\nhệ thống" as Timer <<hệ thống>>

rectangle "BrewLite" {
  usecase "UC-01 Xem menu" as UC01
  usecase "UC-02 Xem chi tiết\nvà chọn tùy chọn" as UC02
  usecase "UC-03 Quản lý giỏ hàng" as UC03
  usecase "UC-04 Đăng ký tài khoản" as UC04
  usecase "UC-05 Đăng nhập" as UC05
  usecase "UC-06 Đặt và thanh toán\nđơn hàng" as UC06 #F3D9B1
  usecase "UC-07 Áp dụng\nmã giảm giá" as UC07
  usecase "UC-08 Theo dõi đơn hàng" as UC08
  usecase "UC-09 Hủy đơn hàng" as UC09
  usecase "UC-12 Xem lịch sử\nđiểm thưởng" as UC12
  usecase "UC-10 Cập nhật\ntrạng thái đơn" as UC10
  usecase "UC-11 Tự hủy đơn quá hạn" as UC11
  usecase "UC-14 Xem giao dịch\nthanh toán" as UC14
  usecase "UC-13 Quản lý kho\nnguyên liệu" as UC13
}

Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC04
Guest --> UC05

Customer --> UC06
Customer --> UC08
Customer --> UC09
Customer --> UC12
Guest <|-- Customer : kế thừa\nmọi use-case

UC07 .[norank].> UC06 : <<extend>>
UC06 .[norank].> UC05 : <<include>>

UC05 <-- Staff
UC10 <-- Staff
UC14 <-- Staff
UC13 <-- Staff
UC06 --> Gateway
UC11 <-- Timer
@enduml
